{
  "name": "multi-venue-grid-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Independent multi-venue perpetual grid engine",
  "type": "module",
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run scan:secrets && npm run build",
    "ci": "npm run check && npm run dry-run",
    "dry-run": "tsx src/index.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "scan:secrets": "node scripts/check-secrets.mjs",
    "test": "tsx --test test/bootstrap/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
