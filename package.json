{
  "name": "multi-venue-grid-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Independent multi-venue perpetual grid engine",
  "type": "module",
  "engines": {
    "node": "26.5.0",
    "npm": "11.17.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run secret:scan && npm run build",
    "dry-run": "tsx src/cli.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "secret:scan": "node scripts/secret-scan.mjs",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
